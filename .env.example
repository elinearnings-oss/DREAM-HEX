# ==========================================
# VELORA ENVIRONMENT CONFIGURATION (.env)
# ==========================================
# Place your real Firebase credentials here for production deployment.
# Client variables MUST be prefixed with VITE_ to be exposed to the Vite React bundle.

# Firebase Web App Credentials
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_DATABASE_ID=your_firestore_database_id_or_default
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id

# Server Port (used by Node.js production server, defaults to 3000)
PORT=3000
